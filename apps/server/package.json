    "@effect/sql-drizzle": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@radix-effects/gateway": "0.6.0-dev.1",
    "@radix-effects/shared": "catalog:",
    "@radix-effects/tx-tool": "0.1.0-dev.1",
    "@radix-vaults/database": "workspace:*",
    "@radix-vaults/shared": "workspace:*",
    "@radixdlt/radix-engine-toolkit": "^1.0.5",
    "@steleaio/radix-engine-toolkit": "2.0.0-dev.5",
    "drizzle-orm": "catalog:",
